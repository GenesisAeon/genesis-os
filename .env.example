# GenesisAeon — local PyPI credentials (NEVER commit .env)
#
# Setup:
#   copy .env.example .env
#   Paste your PyPI API token (https://pypi.org/manage/account/token/)
#
# Used by: scripts/publish_pypi.ps1 | scripts/publish_pypi.sh
# uv reads: UV_PUBLISH_TOKEN (and our scripts mirror PYPI_API_TOKEN → UV_PUBLISH_TOKEN)

PYPI_API_TOKEN=pypi-AgEIcHlwaS5vcmcC...
UV_PUBLISH_TOKEN=pypi-AgEIcHlwaS5vcmcC...

# Optional: ecosystem root for release_all.sh / audits
# GENESISAEON_DIR=D:\mandala